# OpenRouter API Key for AI RAG Chatbot
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fastest Model Router (openrouter/auto dynamically selects the fastest, lowest-latency model at that moment)
OPENROUTER_MODEL=openrouter/auto

# Optional Leaderboard / Analytics metadata
OPENROUTER_SITE_URL=https://www.imramu.me
OPENROUTER_SITE_NAME=RAM-AI Portfolio Hub

# Optional Other APIs
APIFY_API_KEY=your_apify_api_key_here
